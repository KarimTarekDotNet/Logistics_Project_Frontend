# Copy this file to .env.local for local development.
# Never commit real tunnel hosts, callback URLs, API keys, or provider URLs.

# Optional: local Vite proxy target. Use your backend origin here.
# VITE_DEV_API_BASE_URL=<backend-origin>

# Optional: comma-separated dev hostnames if you expose the frontend through a tunnel.
# VITE_DEV_ALLOWED_HOSTS=<frontend-host>

# Optional: set only when your tunnel provider requires a browser-warning bypass header.
# VITE_SKIP_TUNNEL_WARNING=true

# Optional: public API origin for static deployments.
# Values prefixed with VITE_ are bundled into the client and can be seen by users.
# Prefer same-origin API hosting or a server-side proxy instead of exposing external origins.
# VITE_API_BASE_URL=<public-api-origin>

# Online card checkout is prepared by the backend through Payment/start then Payment/checkout.
# These Paymob values are only legacy fallback helpers. Never put Paymob SecretKey, APIKey, HMAC, or webhook secrets in the frontend.
# VITE_PAYMOB_PUBLIC_KEY=<payment-public-key>
# VITE_PAYMOB_BASE_URL=<payment-api-base-origin>
